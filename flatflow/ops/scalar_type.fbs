namespace flatflow;

/// This table defines data types to identify the precision of each tensor
/// operation in the computational graph of a given PyTorch program. It is based
/// on C10 scalar types, while types that are planned to be deprecated including
/// qint8 and bits2x4, or types that remain for historical reasons such as
/// complex64 are omitted.
///
/// The latest version of C10 scalar types can be found at
/// https://github.com/pytorch/pytorch/blob/main/torch/headeronly/core/ScalarType.h
/// or at https://docs.pytorch.org/docs/stable/tensor_attributes.html.
///
/// Note that these data types are incomplete and more data types will be added
/// in the future.
enum ScalarType: ubyte {
  float32,
  float64,
  float16,
  bfloat16,
  bool,
  int8,
  int16,
  int32,
  int64,
  uint8,
  uint16,
  uint32,
  uint64,
  float8_e4m3fn,
  float8_e4m3fnuz,
  float8_e5m2,
  float8_e5m2fnuz,
}
